<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Version>7.5.0</Version>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Resources\app-logo.ico" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4"/>
        <PackageReference Include="TKCode.Arc" Version="1.0.0" />
        <PackageReference Include="TKCode.Arc.Blocks" Version="1.0.0" />
        <PackageReference Include="TKCode.Arc.Fonts" Version="1.0.0" />
        <PackageReference Include="TKCode.Arc.Icons.Lucide" Version="1.0.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1"/>
        <PackageReference Include="hyjiacan.py4n" Version="4.0.0" />
        <PackageReference Include="MessageBox.Avalonia" Version="12.1.0" />
        <PackageReference Include="NAudio" Version="2.2.1" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="NLog" Version="5.4.0" />
        <PackageReference Include="NTextCat" Version="0.3.65" />
        <PackageReference Include="SharpZipLib" Version="1.4.2" />
        <PackageReference Include="ToolGood.Words" Version="3.1.0.2" />
    </ItemGroup>

    <ItemGroup>
      <None Update="NLog.config">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Core14.profile.xml" />
        <EmbeddedResource Include="Resources\settings.ico" />
        <EmbeddedResource Include="Resources\search-result.ico" />
        <EmbeddedResource Include="Resources\Localization\*.json" />
    </ItemGroup>
</Project>
