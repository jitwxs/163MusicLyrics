<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicLyricApp.App"
             xmlns:local="using:MusicLyricApp">
    <!-- Arc (registered in Program.UseArc) supplies the theme for every control, shared ones included. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
</Application>
