<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:MusicLyricApp.ViewModels"
             xmlns:loc="using:MusicLyricApp.Core.Localization"
             mc:Ignorable="d"
             d:DesignWidth="640" d:DesignHeight="520"
             x:Class="MusicLyricApp.Views.BlurSearchView"
             x:DataType="vm:BlurSearchViewModel">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{arc:ArcDesignTokenResource Space3}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space3}">
            <arc:Button Name="BackButton"
                        Variant="Ghost"
                        Size="Small"
                        ToolTip.Tip="{loc:Loc Key=Blur.Back}"
                        AutomationProperties.Name="{loc:Loc Key=Blur.Back}">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ArrowLeft}" />
            </arc:Button>
            <StackPanel Grid.Column="1" Spacing="{arc:ArcDesignTokenResource Space1}" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Key=UI.BlurResults}"
                           FontSize="{arc:ArcDesignTokenResource TypeLG}"
                           FontWeight="SemiBold"
                           Foreground="{arc:ArcDesignTokenResource Foreground}" />
                <TextBlock Text="{Binding SearchResultCountText}"
                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            </StackPanel>
            <arc:Button Grid.Column="2"
                        Name="GetSelectedButton"
                        Variant="Primary"
                        Content="{loc:Loc Key=Blur.GetSelected}"
                        Command="{Binding DownloadSelectedCommand}" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{loc:Loc Key=Blur.Hint}"
                   TextWrapping="Wrap"
                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />

        <arc:Table Grid.Row="2"
                   Name="ResultsTable"
                   ItemsSource="{Binding SearchResults}"
                   IsSelectable="True"
                   IsStriped="True"
                   Caption="{loc:Loc Key=UI.BlurResults}"
                   EmptyMessage="{loc:Loc Key=Table.Empty}"
                   ItemNameOne="{loc:Loc Key=Table.ItemOne}"
                   ItemNameOther="{loc:Loc Key=Table.ItemOther}"
                   SelectedNoun="{loc:Loc Key=Table.Selected}"
                   SelectAllLabel="{loc:Loc Key=Table.SelectAll}"
                   ClearSelectionLabel="{loc:Loc Key=Table.ClearSelection}" />
    </Grid>
</UserControl>
