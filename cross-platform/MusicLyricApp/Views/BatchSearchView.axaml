<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:MusicLyricApp.ViewModels"
             xmlns:loc="using:MusicLyricApp.Core.Localization"
             mc:Ignorable="d"
             x:Name="Root"
             x:Class="MusicLyricApp.Views.BatchSearchView"
             x:DataType="vm:BatchSearchViewModel"
             d:DesignWidth="900" d:DesignHeight="640">

    <UserControl.Styles>
        <Style Selector="Border.pane">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusSurface}" />
        </Style>
        <Style Selector="Border.stat">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinWidth" Value="132" />
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource Type2XL}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="24,16,24,24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="{arc:ArcDesignTokenResource Space4}">

        <!-- Header: what this page is, where the rows came from, and how to add more. -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space4}">
            <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                <TextBlock Text="{loc:Loc Key=Nav.Batch}"
                           FontSize="{arc:ArcDesignTokenResource TypeLG}"
                           FontWeight="SemiBold"
                           Foreground="{arc:ArcDesignTokenResource Foreground}" />
                <TextBlock Classes="secondary" Text="{loc:Loc Key=Batch.Description}" TextWrapping="Wrap" />
                <TextBlock Name="InputSourceText"
                           Classes="secondary"
                           TextTrimming="PathSegmentEllipsis"
                           IsVisible="{Binding BatchInputText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           ToolTip.Tip="{Binding BatchInputText}">
                    <Run Text="{loc:Loc Key=Batch.InputSource}" />
                    <Run Text=": " />
                    <Run Text="{Binding BatchInputText}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Totals for the whole list and for saves made from it. -->
        <WrapPanel Grid.Row="1"
                   ItemSpacing="{arc:ArcDesignTokenResource Space3}"
                   LineSpacing="{arc:ArcDesignTokenResource Space3}">
            <Border Classes="pane stat">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                    <TextBlock Name="TotalCountText" Classes="stat-value" Text="{Binding TotalSongsCount}" />
                    <TextBlock Classes="secondary" Text="{loc:Loc Key=Batch.Stat.Total}" />
                </StackPanel>
            </Border>
            <Border Classes="pane stat">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                    <TextBlock Classes="stat-value" Text="{Binding SongsWithLyricsCount}" />
                    <TextBlock Classes="secondary" Text="{loc:Loc Key=Batch.Stat.WithLyrics}" />
                </StackPanel>
            </Border>
            <Border Classes="pane stat">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                    <TextBlock Classes="stat-value" Text="{Binding SaveSuccessCount}" />
                    <TextBlock Classes="secondary" Text="{loc:Loc Key=Batch.Stat.Saved}" />
                </StackPanel>
            </Border>
            <Border Classes="pane stat">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
                    <TextBlock Classes="stat-value" Text="{Binding SaveFailedCount}" />
                    <TextBlock Classes="secondary" Text="{loc:Loc Key=Batch.Stat.Failed}" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Filter the list; the table shows only matching rows. -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="{arc:ArcDesignTokenResource Space3}"
              IsVisible="{Binding HasItems}">
            <arc:SearchField Name="FilterField"
                             Width="320"
                             Size="Small"
                             Label="{loc:Loc Key=Batch.FilterLabel}"
                             IsLabelVisible="False"
                             Placeholder="{loc:Loc Key=Batch.FilterPlaceholder}"
                             ClearText="{loc:Loc Key=Search.Clear}"
                             Text="{Binding FilterText, Mode=TwoWay}" />
            <TextBlock Grid.Column="1"
                       Name="FilterCountText"
                       Classes="secondary"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsFiltering}"
                       Text="{Binding FilterCountText}" />
        </Grid>

        <!-- The table draws its own frame; only the empty state sits in a card. -->
            <Panel Grid.Row="3">
                <arc:Table Name="BatchTable"
                           ItemsSource="{Binding VisibleItems}"
                           IsVisible="{Binding HasItems}"
                           IsSelectable="True"
                           SelectsOnRowClick="False"
                           IsStriped="True"
                           Caption="{loc:Loc Key=Nav.Batch}"
                           EmptyMessage="{Binding TableEmptyMessage}"
                           ItemNameOne="{loc:Loc Key=Batch.ItemOne}"
                           ItemNameOther="{loc:Loc Key=Batch.ItemOther}"
                           SelectedNoun="{loc:Loc Key=Table.Selected}"
                           SelectAllLabel="{loc:Loc Key=Table.SelectAll}"
                           ClearSelectionLabel="{loc:Loc Key=Table.ClearSelection}" />

                <Border Classes="pane" IsVisible="{Binding !HasItems}">
                    <arc:EmptyState Name="BatchEmptyState"
                                    Icon="{x:Static arc:ArcIcons.ListChecks}"
                                    Title="{loc:Loc Key=Batch.EmptyTitle}"
                                    Description="{loc:Loc Key=Batch.EmptyDescription}" />
                </Border>
            </Panel>

        <!-- Bulk actions on the selected rows; saving is the page's single primary action. -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{arc:ArcDesignTokenResource Space3}"
                    IsVisible="{Binding HasItems}">
            <arc:Button Name="RemoveSelectedButton"
                        Variant="Danger"
                        Content="{loc:Loc Key=Batch.RemoveSelected}"
                        Command="{Binding ExecuteDeleteSelectedCommand}" />
            <arc:Button Name="SaveSelectedButton"
                        Variant="Primary"
                        Content="{loc:Loc Key=Batch.SaveSelected}"
                        Command="{Binding ExecuteSaveSelectedCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
