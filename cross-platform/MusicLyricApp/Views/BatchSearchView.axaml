<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:MusicLyricApp.ViewModels"
             xmlns:loc="using:MusicLyricApp.Core.Localization"
             mc:Ignorable="d"
             x:Name="Root"
             x:Class="MusicLyricApp.Views.BatchSearchView"
             x:DataType="viewModels:BatchSearchViewModel"
             d:DesignWidth="900" d:DesignHeight="640">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="12" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding BatchInputText}"
                     Height="60"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     IsReadOnly="True" />
            <Button Grid.Column="1"
                    Content="{loc:Loc Key=UI.LocalScan}"
                    Width="130"
                    Command="{Binding ExecuteSelectFolderCommand}" />
        </Grid>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="True"
                  RowHeight="30"
                  BorderThickness="1">
            <DataGrid.Styles>
                <Style Selector="DataGridRow">
                    <Setter Property="ContextMenu">
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc Key=UI.Save}"
                                      Command="{Binding #Root.DataContext.ExecuteContextSaveCommand}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="{loc:Loc Key=UI.ViewDetails}"
                                      Command="{Binding #Root.DataContext.ExecuteViewDetailCommand}"
                                      CommandParameter="{Binding}" />
                        </ContextMenu>
                    </Setter>
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="40" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Loc Key=UI.SongSource}" Binding="{Binding SongSource}" Width="90" />
                <DataGridTextColumn Header="{loc:Loc Key=UI.SongId}" Binding="{Binding SongId}" Width="120" />
                <DataGridTextColumn Header="{loc:Loc Key=UI.SongName}" Binding="{Binding SongName}" Width="*" />
                <DataGridTextColumn Header="{loc:Loc Key=UI.Singer}" Binding="{Binding Singer}" Width="180" />
                <DataGridTextColumn Header="{loc:Loc Key=UI.Album}" Binding="{Binding Album}" Width="200" />
                <DataGridTemplateColumn Header="{loc:Loc Key=UI.Extra01}" Width="120" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{loc:Loc Key=UI.Extra02}" Width="260" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Error}"
                                       Foreground="#B42318"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Error}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Loc Key=UI.SelectAll}" Width="110" Command="{Binding ExecuteSelectAllCommand}" />
            <Button Content="{loc:Loc Key=UI.ClearSelection}" Width="130" Command="{Binding ExecuteClearSelectedCommand}" />
            <Button Content="{loc:Loc Key=UI.SaveSelected}" Width="130" Command="{Binding ExecuteSaveSelectedCommand}" />
            <Button Content="{loc:Loc Key=UI.DeleteSelected}" Width="130" Command="{Binding ExecuteDeleteSelectedCommand}" />
        </StackPanel>

        <Border Grid.Row="3" Padding="8" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Background="#FAFBFC">
            <TextBlock TextTrimming="CharacterEllipsis">
                <Run Text="{loc:Loc Key=UI.Extra03}" Foreground="#344054" />
                <Run Text="[" Foreground="#98A2B3" />
                <Run Text="{Binding TipTimestamp}" Foreground="#98A2B3" />
                <Run Text="] " Foreground="#98A2B3" />
                <Run Text="{Binding TipNormalMessage}" Foreground="#667085" />
                <Run Text="{Binding TipErrorMessage}" Foreground="IndianRed" />
                <Run Text="{loc:Loc Key=UI.Extra04}" Foreground="#344054" />
                <Run Text="{Binding TotalSongsCount}" Foreground="#344054" />
                <Run Text="{loc:Loc Key=UI.Extra05}" Foreground="#344054" />
                <Run Text="{Binding SongsWithLyricsCount}" Foreground="#344054" />
                <Run Text="{loc:Loc Key=UI.Extra06}" Foreground="#344054" />
                <Run Text="{Binding SaveSuccessCount}" Foreground="#2E7D32" />
                <Run Text="{loc:Loc Key=UI.Extra07}" Foreground="#344054" />
                <Run Text="{Binding SaveFailedCount}" Foreground="IndianRed" />
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
