<arc:ArcWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
               xmlns:vm="using:MusicLyricApp.ViewModels"
               xmlns:views="using:MusicLyricApp.Views"
               xmlns:loc="using:MusicLyricApp.Core.Localization"
               x:Class="MusicLyricApp.Views.MainWindow"
               x:DataType="vm:MainWindowViewModel"
               Icon="/Resources/app-logo.ico"
               Title="{Binding AppTitle}"
               Background="{arc:ArcDesignTokenResource Background}"
               Width="1080"
               Height="760"
               MinWidth="860"
               MinHeight="620">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <arc:Sidebar Name="NavSidebar"
                     DockPanel.Dock="Left"
                     ResizeMode="Push"
                     Label="{loc:Loc Key=Nav.Label}"
                     CollapseButtonText="{loc:Loc Key=Nav.CollapseSidebar}"
                     ExpandButtonText="{loc:Loc Key=Nav.ExpandSidebar}"
                     SelectedKey="{Binding CurrentPageKey, Mode=TwoWay}">
            <arc:SidebarSection>
                <arc:SidebarItem Key="search"
                                 Label="{loc:Loc Key=Nav.Search}"
                                 Icon="{x:Static arc:ArcIcons.Cloud}" />
                <arc:SidebarItem
                                 Key="batch"
                                 Label="{loc:Loc Key=Nav.Batch}"
                                 Icon="{x:Static arc:ArcIcons.ListChecks}" />
                <arc:SidebarItem Key="convert"
                                 Label="{loc:Loc Key=Nav.Convert}"
                                 Icon="{x:Static arc:ArcIcons.ArrowDownUp}" />
                <arc:SidebarItem Key="local"
                                 Label="{loc:Loc Key=Nav.Local}"
                                 Icon="{x:Static arc:ArcIcons.Laptop}" />
            </arc:SidebarSection>
            <!-- Settings sections live here rather than in a second navigation inside the page. -->
            <arc:SidebarSection>
                <arc:SidebarItem Key="settings"
                                 Label="{loc:Loc Key=Nav.Settings}"
                                 Icon="{x:Static arc:ArcIcons.Settings}"
                                 IsExpanded="True">
                    <arc:SidebarItem Key="settings/lyrics" Label="{loc:Loc Key=UI.LyricCustomization}" />
                    <arc:SidebarItem Key="settings/extensions" Label="{loc:Loc Key=UI.Extensions}" />
                    <arc:SidebarItem Key="settings/network" Label="{loc:Loc Key=UI.Network}" />
                    <arc:SidebarItem Key="settings/download" Label="{loc:Loc Key=UI.DownloadCache}" />
                    <arc:SidebarItem Key="settings/application" Label="{loc:Loc Key=UI.Application}" />
                    <arc:SidebarItem Key="settings/shortcuts" Label="{loc:Loc Key=UI.Shortcuts}" />
                </arc:SidebarItem>
            </arc:SidebarSection>

            <!-- Help: actions that open links, without changing the page. -->
            <arc:SidebarSection Header="{loc:Loc Key=UI.Help}">
                <arc:SidebarItem Key="help/home" IsAction="True"
                                 Label="{loc:Loc Key=UI.ProjectHome}"
                                 Icon="{x:Static arc:ArcIcons.House}" />
                <arc:SidebarItem Key="help/wiki" IsAction="True"
                                 Label="{loc:Loc Key=UI.UserGuide}"
                                 Icon="{x:Static arc:ArcIcons.BookOpen}" />
                <arc:SidebarItem Key="help/issue" IsAction="True"
                                 Label="{loc:Loc Key=UI.Feedback}"
                                 Icon="{x:Static arc:ArcIcons.MessageSquare}" />
            </arc:SidebarSection>
        </arc:Sidebar>

        <!-- Pages stay alive while hidden so typed input and scroll positions survive navigation. -->
        <Panel>
            <views:SearchView Name="SearchPage" IsVisible="{Binding IsSearchPage}" />
            <views:BatchSearchView Name="BatchPage"
                                   DataContext="{Binding BatchSearchViewModel}"
                                   IsVisible="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).IsBatchPage}" />
            <views:FormatConvertView Name="ConvertPage"
                                     DataContext="{Binding FormatConvertViewModel}"
                                     IsVisible="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).IsConvertPage}" />
            <views:LocalMusicScanView Name="LocalPage"
                                      DataContext="{Binding LocalMusicScanViewModel}"
                                      IsVisible="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).IsLocalPage}" />
            <views:SettingView Name="SettingsPage"
                               DataContext="{Binding SettingViewModel}"
                               IsVisible="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).IsSettingsPage}" />
        </Panel>
    </DockPanel>
</arc:ArcWindow>
