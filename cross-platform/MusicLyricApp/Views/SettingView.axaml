<UserControl
    x:Class="MusicLyricApp.Views.SettingView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:MusicLyricApp.ViewModels"
    x:DataType="viewModels:SettingViewModel"
    mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TabControl > TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
    </UserControl.Styles>

    <Grid
        Margin="12"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="10">
        <TabControl Grid.Row="1" TabStripPlacement="Top">
            <TabItem Header="歌词定制">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Spacing="10">
                        <Border
                            Padding="12"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid
                                ColumnDefinitions="140,*"
                                ColumnSpacing="10"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                RowSpacing="10">
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="中文处理" />
                                <ComboBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    ItemsSource="{Binding SettingParamViewModel.ChineseProcessRules}"
                                    SelectedItem="{Binding SettingParamViewModel.SelectedChineseProcessRuleItem}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="逐字歌词" />
                                <ComboBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    ItemsSource="{Binding SettingParamViewModel.VerbatimLyricMode}"
                                    SelectedItem="{Binding SettingParamViewModel.SelectedVerbatimLyricModeItem}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="译文缺省规则" />
                                <ComboBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    ItemsSource="{Binding SettingParamViewModel.TransLyricLostRules}"
                                    SelectedItem="{Binding SettingParamViewModel.SelectedTransLyricLostRuleItem}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="译文匹配精度(ms)" />
                                <TextBox
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="{Binding SettingParamViewModel.MatchPrecisionDeviation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="歌词合并符" />
                                <TextBox
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Text="{Binding SettingParamViewModel.LrcMergeSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <CheckBox
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Content="跳过空白歌词行"
                                    IsChecked="{Binding SettingParamViewModel.IgnoreEmptyLyric, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <Border
                            Padding="12"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="时间标签格式设置" />
                                    <Button
                                        Width="22"
                                        Height="22"
                                        Padding="0"
                                        Command="{Binding TimestampTipsCommand}"
                                        Content="?" />
                                </StackPanel>
                                <Grid
                                    ColumnDefinitions="140,*"
                                    ColumnSpacing="10"
                                    RowDefinitions="Auto,Auto,Auto"
                                    RowSpacing="8">
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="LRC 时间戳" />
                                    <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Text="{Binding SettingParamViewModel.LrcTimestampFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="SRT 时间戳" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding SettingParamViewModel.SrtTimestampFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="毫秒截位规则" />
                                    <ComboBox
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        ItemsSource="{Binding SettingParamViewModel.DotTypes}"
                                        SelectedItem="{Binding SettingParamViewModel.SelectedDotTypeItem}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="12"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="歌词类型优先级（右键可上移/下移）" />
                                <DataGrid
                                    Height="260"
                                    AutoGenerateColumns="False"
                                    BorderThickness="1"
                                    CanUserReorderColumns="False"
                                    ItemsSource="{Binding LyricsTypes}"
                                    SelectedItem="{Binding SelectedLyricsTypeItem, Mode=TwoWay}"
                                    SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn
                                            Width="80"
                                            CanUserSort="False"
                                            Header="启用">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsSelected}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding Name}"
                                            CanUserSort="False"
                                            Header="歌词类型" />
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding MoveUpCommand}" Header="上移" />
                                            <MenuItem Command="{Binding MoveDownCommand}" Header="下移" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="扩展">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Spacing="10">
                        <Border
                            Padding="12"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid
                                ColumnDefinitions="140,*"
                                ColumnSpacing="10"
                                RowDefinitions="Auto,Auto,Auto"
                                RowSpacing="8">
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="百度翻译 APP ID" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding SettingParamViewModel.BaiduAppId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="百度翻译密钥" />
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding SettingParamViewModel.BaiduSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="彩云小译 Token" />
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding SettingParamViewModel.CaiYunToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <Border
                            Padding="12"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid
                                ColumnDefinitions="140,*"
                                ColumnSpacing="10"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="8">
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="网易云 Cookie" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding SettingParamViewModel.NetEaseCookie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="QQ音乐 Cookie" />
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding SettingParamViewModel.QqMusicCookie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="网络设置">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Spacing="10">
                        <Border
                            Padding="12"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="代理设置" />
                                <TextBlock
                                    Foreground="#667085"
                                    Text="系统代理：跟随系统/全局 VPN；直接连接：禁用系统代理；HTTP 代理：使用手动填写的代理服务器。"
                                    TextWrapping="Wrap" />
                                <Grid
                                    ColumnDefinitions="140,*,80,*"
                                    ColumnSpacing="10"
                                    RowDefinitions="Auto,Auto,Auto"
                                    RowSpacing="8">
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="类型" />
                                    <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="3"
                                        ItemsSource="{Binding SettingParamViewModel.NetworkProxyModes}"
                                        SelectedItem="{Binding SettingParamViewModel.SelectedNetworkProxyModeItem}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="地址" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        IsEnabled="{Binding SettingParamViewModel.IsHttpProxySelected}"
                                        Text="{Binding SettingParamViewModel.ProxyHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="端口" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="3"
                                        IsEnabled="{Binding SettingParamViewModel.IsHttpProxySelected}"
                                        Text="{Binding SettingParamViewModel.ProxyPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="用户名" />
                                    <TextBox
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        IsEnabled="{Binding SettingParamViewModel.IsHttpProxySelected}"
                                        Text="{Binding SettingParamViewModel.ProxyUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="密码" />
                                    <TextBox
                                        Grid.Row="2"
                                        Grid.Column="3"
                                        IsEnabled="{Binding SettingParamViewModel.IsHttpProxySelected}"
                                        PasswordChar="*"
                                        Text="{Binding SettingParamViewModel.ProxyPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <TextBlock Foreground="IndianRed" Text="{Binding SettingParamViewModel.ProxyPortError}" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Width="90"
                                        Command="{Binding TestProxyCommand}"
                                        Content="测试"
                                        IsEnabled="{Binding SettingParamViewModel.IsHttpProxySelected}" />
                                    <Button
                                        Width="90"
                                        Command="{Binding ApplyProxyCommand}"
                                        Content="应用" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="#667085"
                                        Text="更改后部分请求需重启应用才会完全生效" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="下载与缓存">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Spacing="10">
                        <Border
                            Padding="12"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="下载与缓存行为" />
                                    <Button
                                        Width="22"
                                        Height="22"
                                        Padding="0"
                                        Command="{Binding OutputTipsCommand}"
                                        Content="?" />
                                </StackPanel>
                                <TextBlock Foreground="#667085" Text="控制歌词保存时的附加下载和命名规则" />
                                <Border
                                    Height="1"
                                    Margin="0,2,0,2"
                                    Background="#EAECF0" />
                                <WrapPanel>
                                    <CheckBox
                                        Margin="0,0,12,8"
                                        Content="跳过纯音乐"
                                        IsChecked="{Binding SettingParamViewModel.IgnorePureMusicInSave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox
                                        Margin="0,0,12,8"
                                        Content="“独立”歌词分文件保存"
                                        IsChecked="{Binding SettingParamViewModel.SeparateFileForIsolated, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox
                                        Margin="0,0,12,8"
                                        Content="同时下载封面和直链"
                                        IsChecked="{Binding SettingParamViewModel.DownloadCoverAndSongLinkOnSave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                                <Grid
                                    ColumnDefinitions="140,*"
                                    ColumnSpacing="10"
                                    RowDefinitions="Auto,Auto,Auto"
                                    RowSpacing="8">
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="歌手分隔符" />
                                    <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Text="{Binding SettingParamViewModel.SingerSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="保存文件名" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding SettingParamViewModel.OutputFileNameFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="歌手数上限" />
                                    <StackPanel
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBox Width="100" Text="{Binding SettingParamViewModel.SingerCountLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="#667085"
                                            Text="-1 表示不截断" />
                                    </StackPanel>
                                </Grid>
                                <Border
                                    Height="1"
                                    Margin="0,2,0,2"
                                    Background="#EAECF0" />
                                <Grid
                                    ColumnDefinitions="140,*"
                                    ColumnSpacing="10"
                                    RowDefinitions="Auto,Auto"
                                    RowSpacing="8">
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="同名文件处理" />
                                    <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        ItemsSource="{Binding SettingParamViewModel.FileConflictStrategies}"
                                        SelectedItem="{Binding SettingParamViewModel.SelectedFileConflictStrategyItem}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="编号后缀模板" />
                                    <StackPanel
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBox
                                            Width="180"
                                            IsEnabled="{Binding SettingParamViewModel.IsConflictSuffixEnabled}"
                                            Text="{Binding SettingParamViewModel.FileConflictSuffixPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="#667085"
                                            Text="使用 {n} 代表序号，例如  ({n}) 或 -v{n}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="12"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="保存路径" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0" Text="{Binding SettingParamViewModel.SaveFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="1"
                                        Width="80"
                                        Command="{Binding SelectSaveFolderCommand}"
                                        Content="选择" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="12"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="本地搜索缓存" />
                                <Grid
                                    ColumnDefinitions="140,*,Auto,Auto"
                                    ColumnSpacing="8"
                                    RowDefinitions="Auto,Auto"
                                    RowSpacing="8">
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="缓存目录" />
                                    <TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Text="{Binding SettingParamViewModel.SearchCacheFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Width="90"
                                        Command="{Binding SelectSearchCacheFolderCommand}"
                                        Content="更改目录" />
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Width="90"
                                        Command="{Binding OpenSearchCachePathCommand}"
                                        Content="打开目录" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="最大缓存(MB)" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        Text="{Binding SettingParamViewModel.SearchCacheMaxSizeMbText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Grid.ColumnSpan="2"
                                        VerticalAlignment="Center"
                                        Foreground="IndianRed"
                                        Text="{Binding SettingParamViewModel.SearchCacheSizeError}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="应用设置">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Spacing="10">
                        <Border
                            Padding="12"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="8">
                                <WrapPanel>
                                    <CheckBox
                                        Margin="0,0,12,8"
                                        Content="聚合模糊搜索"
                                        IsChecked="{Binding SettingParamViewModel.AggregatedBlurSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox
                                        Margin="0,0,12,8"
                                        Content="自动读取剪贴板"
                                        IsChecked="{Binding SettingParamViewModel.AutoReadClipboard, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox
                                        Margin="0,0,12,8"
                                        Content="自动检查更新"
                                        IsChecked="{Binding SettingParamViewModel.AutoCheckUpdate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox
                                        Margin="0,0,12,8"
                                        Content="关闭软件时二次确认"
                                        IsChecked="{Binding SettingParamViewModel.ConfirmBeforeExit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                                <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="主题模式" />
                                    <ComboBox
                                        Grid.Column="1"
                                        ItemsSource="{Binding SettingParamViewModel.ThemeModeRules}"
                                        SelectedItem="{Binding SettingParamViewModel.SelectedThemeModeRuleItem}" />
                                </Grid>
                                <Button
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    Command="{Binding CheckUpdateCommand}"
                                    Content="检查更新" />
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="12"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="快捷键" />
                                <TextBlock Foreground="#667085">
                                    <Run Text="Enter：精确搜索" />
                                    <LineBreak />
                                    <Run Text="Ctrl + Enter：模糊搜索" />
                                    <LineBreak />
                                    <Run Text="Ctrl + S：保存结果" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="12"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="配置文件" />
                                <TextBox
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsReadOnly="True"
                                    Text="{Binding ConfigPath}" />
                                <Button
                                    Grid.Column="2"
                                    Width="70"
                                    Command="{Binding OpenConfigPathCommand}"
                                    Content="打开" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border
            Grid.Row="2"
            Padding="8"
            BorderBrush="#D0D7DE"
            BorderThickness="1"
            CornerRadius="6">
            <TextBox
                Height="120"
                AcceptsReturn="True"
                Background="Transparent"
                BorderThickness="0"
                IsReadOnly="True"
                Text="{Binding SettingTips}" />
        </Border>
    </Grid>
</UserControl>
