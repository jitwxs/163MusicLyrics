<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:MusicLyricApp.ViewModels"
             xmlns:loc="using:MusicLyricApp.Core.Localization"
             mc:Ignorable="d"
             x:Class="MusicLyricApp.Views.SettingView"
             x:DataType="viewModels:SettingViewModel">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.settings-card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
        </Style>
        <Style Selector="Border.settings-divider">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
        <Style Selector="Button.subtle">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="TabControl > TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" Margin="12">
        <TabControl Grid.Row="1" TabStripPlacement="Top">
            <TabItem Header="{loc:Loc Key=UI.LyricCustomization}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" Margin="10">
                        <Border Padding="12" BorderThickness="1" CornerRadius="8" Classes="settings-card">
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=UI.ChineseProcessing}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding SettingParamViewModel.ChineseProcessRules}"
                                          SelectedItem="{Binding SettingParamViewModel.SelectedChineseProcessRuleItem}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=UI.VerbatimLyrics}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding SettingParamViewModel.VerbatimLyricMode}"
                                          SelectedItem="{Binding SettingParamViewModel.SelectedVerbatimLyricModeItem}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=UI.MissingTranslation}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          ItemsSource="{Binding SettingParamViewModel.TransLyricLostRules}"
                                          SelectedItem="{Binding SettingParamViewModel.SelectedTransLyricLostRuleItem}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Key=UI.MatchPrecision}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1"
                                         Text="{Binding SettingParamViewModel.MatchPrecisionDeviation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Key=UI.MergeSeparator}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Text="{Binding SettingParamViewModel.LrcMergeSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                          Content="{loc:Loc Key=UI.SkipEmptyLyrics}"
                                          IsChecked="{Binding SettingParamViewModel.IgnoreEmptyLyric, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <Border Padding="12" BorderThickness="1" CornerRadius="8" Classes="settings-card">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{loc:Loc Key=UI.TimestampFormat}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Width="22" Height="22" Padding="0" Content="?" Command="{Binding TimestampTipsCommand}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=UI.LrcTimestamp}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding SettingParamViewModel.LrcTimestampFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=UI.SrtTimestamp}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding SettingParamViewModel.SrtTimestampFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=UI.MillisecondRule}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="2" Grid.Column="1"
                                              ItemsSource="{Binding SettingParamViewModel.DotTypes}"
                                              SelectedItem="{Binding SettingParamViewModel.SelectedDotTypeItem}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="12" BorderThickness="1" CornerRadius="8" Classes="settings-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Loc Key=UI.LyricPriority}" FontWeight="SemiBold" />
                                <DataGrid ItemsSource="{Binding LyricsTypes}"
                                          AutoGenerateColumns="False"
                                          SelectionMode="Single"
                                          SelectedItem="{Binding SelectedLyricsTypeItem, Mode=TwoWay}"
                                          CanUserReorderColumns="False"
                                          BorderThickness="1"
                                          Height="260">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{loc:Loc Key=UI.Enabled}" Width="80" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{loc:Loc Key=UI.LyricType}" Binding="{Binding Name}" Width="*" CanUserSort="False" />
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Loc Key=UI.MoveUp}" Command="{Binding MoveUpCommand}" />
                                            <MenuItem Header="{loc:Loc Key=UI.MoveDown}" Command="{Binding MoveDownCommand}" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Loc Key=UI.Extensions}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" Margin="10">
                        <Border Padding="12" BorderThickness="1" CornerRadius="8" Classes="settings-card">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="140,*" ColumnSpacing="10" RowSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=UI.Extra08}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding SettingParamViewModel.BaiduAppId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=UI.Extra09}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding SettingParamViewModel.BaiduSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=UI.Extra10}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding SettingParamViewModel.CaiYunToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <Border Padding="12" BorderThickness="1" CornerRadius="8" Classes="settings-card">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="140,*" ColumnSpacing="10" RowSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=UI.Extra11}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding SettingParamViewModel.NetEaseCookie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=UI.Extra12}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding SettingParamViewModel.QqMusicCookie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Loc Key=UI.Network}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" Margin="10">
                        <Border Padding="12" BorderThickness="1" CornerRadius="8" Classes="settings-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Loc Key=UI.ProxySettings}" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Loc Key=UI.ProxyHelp}" Classes="secondary" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="140,*,80,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=UI.Type}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                              ItemsSource="{Binding SettingParamViewModel.NetworkProxyModes}"
                                              SelectedItem="{Binding SettingParamViewModel.SelectedNetworkProxyModeItem}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=UI.Address}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             IsEnabled="{Binding SettingParamViewModel.IsHttpProxySelected}"
                                             Text="{Binding SettingParamViewModel.ProxyHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Loc Key=UI.Port}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="3"
                                             IsEnabled="{Binding SettingParamViewModel.IsHttpProxySelected}"
                                             Text="{Binding SettingParamViewModel.ProxyPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=UI.Username}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             IsEnabled="{Binding SettingParamViewModel.IsHttpProxySelected}"
                                             Text="{Binding SettingParamViewModel.ProxyUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:Loc Key=UI.Password}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="3"
                                             IsEnabled="{Binding SettingParamViewModel.IsHttpProxySelected}"
                                             PasswordChar="*"
                                             Text="{Binding SettingParamViewModel.ProxyPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <TextBlock Text="{Binding SettingParamViewModel.ProxyPortError}" Foreground="IndianRed" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Width="90"
                                            Content="{loc:Loc Key=UI.Test}"
                                            Command="{Binding TestProxyCommand}"
                                            IsEnabled="{Binding SettingParamViewModel.IsHttpProxySelected}" />
                                    <Button Width="90"
                                            Content="{loc:Loc Key=UI.Apply}"
                                            Command="{Binding ApplyProxyCommand}" />
                                    <TextBlock Text="{loc:Loc Key=UI.ProxyRestart}" Classes="secondary" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Loc Key=UI.DownloadCache}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" Margin="10">
                        <Border Padding="12" BorderThickness="1" CornerRadius="8" Classes="settings-card">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{loc:Loc Key=UI.DownloadBehavior}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Width="22" Height="22" Padding="0" Content="?" Command="{Binding OutputTipsCommand}" />
                                </StackPanel>
                                <TextBlock Text="{loc:Loc Key=UI.DownloadHelp}" Classes="secondary" />
                                <Border Height="1" Margin="0,2,0,2" Classes="settings-divider" />
                                <WrapPanel>
                                    <CheckBox Content="{loc:Loc Key=UI.SkipInstrumental}"
                                              IsChecked="{Binding SettingParamViewModel.IgnorePureMusicInSave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,0,12,8" />
                                    <CheckBox Content="{loc:Loc Key=UI.SeparateIsolated}"
                                              IsChecked="{Binding SettingParamViewModel.SeparateFileForIsolated, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,0,12,8" />
                                    <CheckBox Content="{loc:Loc Key=UI.DownloadExtras}"
                                              IsChecked="{Binding SettingParamViewModel.DownloadCoverAndSongLinkOnSave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,0,12,8" />
                                </WrapPanel>
                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=UI.ArtistSeparator}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding SettingParamViewModel.SingerSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=UI.FileName}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding SettingParamViewModel.OutputFileNameFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=UI.ArtistLimit}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <TextBox Width="100"
                                                 Text="{Binding SettingParamViewModel.SingerCountLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{loc:Loc Key=UI.Extra13}" Classes="secondary" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Margin="0,2,0,2" Classes="settings-divider" />
                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=UI.Extra14}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="0" Grid.Column="1"
                                              ItemsSource="{Binding SettingParamViewModel.FileConflictStrategies}"
                                              SelectedItem="{Binding SettingParamViewModel.SelectedFileConflictStrategyItem}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=UI.Extra15}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <TextBox Width="180"
                                                 IsEnabled="{Binding SettingParamViewModel.IsConflictSuffixEnabled}"
                                                 Text="{Binding SettingParamViewModel.FileConflictSuffixPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{loc:Loc Key=UI.Extra16}" Classes="secondary" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="12" BorderThickness="1" CornerRadius="8" Classes="settings-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Loc Key=UI.Extra17}" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding SettingParamViewModel.SaveFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1"
                                            Content="{loc:Loc Key=UI.Extra18}"
                                            Width="80"
                                            Classes="subtle"
                                            Command="{Binding SelectSaveFolderCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="12" BorderThickness="1" CornerRadius="8" Classes="settings-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{loc:Loc Key=UI.Extra19}" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="140,*,Auto,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=UI.Extra20}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding SettingParamViewModel.SearchCacheFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Content="{loc:Loc Key=UI.Extra21}"
                                            Width="90"
                                            Classes="subtle"
                                            Command="{Binding SelectSearchCacheFolderCommand}" />
                                    <Button Grid.Row="0" Grid.Column="3"
                                            Content="{loc:Loc Key=UI.Extra22}"
                                            Width="90"
                                            Classes="subtle"
                                            Command="{Binding OpenSearchCachePathCommand}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=UI.Extra23}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Width="120"
                                             HorizontalAlignment="Left"
                                             Text="{Binding SettingParamViewModel.SearchCacheMaxSizeMbText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                               VerticalAlignment="Center"
                                               Foreground="IndianRed"
                                               Text="{Binding SettingParamViewModel.SearchCacheSizeError}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Loc Key=UI.Application}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" Margin="10">
                        <Border Padding="12" BorderThickness="1" CornerRadius="8" Classes="settings-card">
                            <StackPanel Spacing="8">
                                <WrapPanel>
                                    <CheckBox Content="{loc:Loc Key=UI.Extra24}"
                                              IsChecked="{Binding SettingParamViewModel.AggregatedBlurSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,0,12,8" />
                                    <CheckBox Content="{loc:Loc Key=UI.Extra25}"
                                              IsChecked="{Binding SettingParamViewModel.AutoReadClipboard, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,0,12,8" />
                                    <CheckBox Content="{loc:Loc Key=UI.Extra26}"
                                              IsChecked="{Binding SettingParamViewModel.AutoCheckUpdate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,0,12,8" />
                                    <CheckBox Content="{loc:Loc Key=UI.Extra27}"
                                              IsChecked="{Binding SettingParamViewModel.ConfirmBeforeExit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,0,12,8" />
                                </WrapPanel>
                                <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Key=UI.Extra28}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding SettingParamViewModel.ThemeModeRules}"
                                              SelectedItem="{Binding SettingParamViewModel.SelectedThemeModeRuleItem}" />
                                </Grid>
                                <Grid ColumnDefinitions="140,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Key=UI.Language}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SettingParamViewModel.Languages}"
                                              SelectedItem="{Binding SettingParamViewModel.SelectedLanguage}" />
                                </Grid>
                                <TextBlock Text="{loc:Loc Key=UI.LanguageRestart}" Classes="secondary" />
                                <Button Width="120"
                                        HorizontalAlignment="Left"
                                        Content="{loc:Loc Key=UI.Extra29}"
                                        Command="{Binding CheckUpdateCommand}" />
                            </StackPanel>
                        </Border>

                        <Border Padding="12" BorderThickness="1" CornerRadius="8" Classes="settings-card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Loc Key=UI.Extra30}" FontWeight="SemiBold" />
                                <TextBlock Classes="secondary">
                                    <Run Text="{loc:Loc Key=UI.Extra31}" />
                                    <LineBreak />
                                    <Run Text="{loc:Loc Key=UI.Extra32}" />
                                    <LineBreak />
                                    <Run Text="{loc:Loc Key=UI.Extra33}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Padding="12" BorderThickness="1" CornerRadius="8" Classes="settings-card">
                            <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Text="{loc:Loc Key=UI.Extra34}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding ConfigPath}" IsReadOnly="True" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="{loc:Loc Key=UI.Extra35}" Width="70" Command="{Binding OpenConfigPathCommand}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Padding="8" BorderThickness="1" CornerRadius="6" Classes="settings-card">
            <TextBox Text="{Binding SettingTips}" IsReadOnly="True" AcceptsReturn="True" Height="120" BorderThickness="0" Background="Transparent" />
        </Border>
    </Grid>
</UserControl>
