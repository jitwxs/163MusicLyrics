<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:viewModels="clr-namespace:MusicLyricApp.ViewModels"
             xmlns:models="using:MusicLyricApp.Models"
             xmlns:loc="using:MusicLyricApp.Core.Localization"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="700"
             x:Class="MusicLyricApp.Views.SettingView"
             x:DataType="viewModels:SettingViewModel">

    <UserControl.Styles>
        <!-- Field controls inside rows carry their label in the row header, so hide their own. -->
        <!-- Keep label and control on one line down to a narrow content column (sidebar plus section nav). -->
        <Style Selector="arc|SettingsRow">
            <Setter Property="StackWidth" Value="360" />
        </Style>
        <Style Selector="arc|SettingsRow arc|Input, arc|SettingsRow arc|PasswordField, arc|SettingsRow arc|NumberField">
            <Setter Property="IsLabelVisible" Value="False" />
            <Setter Property="Size" Value="Small" />
            <Setter Property="MinWidth" Value="200" />
        </Style>
        <Style Selector="arc|SettingsRow arc|Select">
            <Setter Property="Size" Value="Small" />
            <Setter Property="MinWidth" Value="200" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="24,16,24,0" RowSpacing="{arc:ArcDesignTokenResource Space3}">

        <!-- Help text and test results from the settings commands. -->
        <arc:Alert Name="SettingTipsAlert"
                   Tone="Info"
                   Title="{loc:Loc Key=Dialog.Notice.Title}"
                   IsVisible="{Binding HasSettingTips}">
            <SelectableTextBlock Text="{Binding SettingTips}" TextWrapping="Wrap" />
        </arc:Alert>

        <arc:SettingsPage Grid.Row="1" Name="SettingsPage" Title="{loc:Loc Key=Nav.Settings}">

            <!-- 1. Lyrics -->
            <arc:SettingsSection Name="LyricsSection"
                                 Header="{loc:Loc Key=UI.LyricCustomization}"
                                 Icon="{x:Static arc:ArcIcons.Music}">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space6}">
                    <arc:SettingsGroup Header="{loc:Loc Key=Settings.Group.General}">
                        <arc:SettingsRow Header="{loc:Loc Key=UI.ChineseProcessing}">
                            <arc:Select ItemsSource="{Binding SettingParamViewModel.ChineseProcessRules}"
                                        SelectedItem="{Binding SettingParamViewModel.SelectedChineseProcessRuleItem}"
                                        DisplayMemberBinding="{ReflectionBinding DisplayName}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.VerbatimLyrics}">
                            <arc:Select ItemsSource="{Binding SettingParamViewModel.VerbatimLyricMode}"
                                        SelectedItem="{Binding SettingParamViewModel.SelectedVerbatimLyricModeItem}"
                                        DisplayMemberBinding="{ReflectionBinding DisplayName}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.MissingTranslation}">
                            <arc:Select ItemsSource="{Binding SettingParamViewModel.TransLyricLostRules}"
                                        SelectedItem="{Binding SettingParamViewModel.SelectedTransLyricLostRuleItem}"
                                        DisplayMemberBinding="{ReflectionBinding DisplayName}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.MatchPrecision}">
                            <arc:NumberField Label="{loc:Loc Key=UI.MatchPrecision}"
                                             Minimum="0" Maximum="100000" Step="10"
                                             Value="{Binding SettingParamViewModel.MatchPrecisionDeviation, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.MergeSeparator}">
                            <arc:Input Label="{loc:Loc Key=UI.MergeSeparator}"
                                       Text="{Binding SettingParamViewModel.LrcMergeSeparator, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.SkipEmptyLyrics}">
                            <arc:Switch AutomationProperties.Name="{loc:Loc Key=UI.SkipEmptyLyrics}"
                                        IsChecked="{Binding SettingParamViewModel.IgnoreEmptyLyric, Mode=TwoWay}" />
                        </arc:SettingsRow>
                    </arc:SettingsGroup>

                    <arc:SettingsGroup Header="{loc:Loc Key=UI.TimestampFormat}">
                        <arc:SettingsGroup.HeaderActions>
                            <arc:Button Variant="Ghost" Size="Small"
                                        Content="{loc:Loc Key=Settings.ShowHelp}"
                                        Command="{Binding TimestampTipsCommand}" />
                        </arc:SettingsGroup.HeaderActions>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.LrcTimestamp}">
                            <arc:Input Label="{loc:Loc Key=UI.LrcTimestamp}"
                                       Text="{Binding SettingParamViewModel.LrcTimestampFormat, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.SrtTimestamp}">
                            <arc:Input Label="{loc:Loc Key=UI.SrtTimestamp}"
                                       Text="{Binding SettingParamViewModel.SrtTimestampFormat, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.MillisecondRule}">
                            <arc:Select ItemsSource="{Binding SettingParamViewModel.DotTypes}"
                                        SelectedItem="{Binding SettingParamViewModel.SelectedDotTypeItem}"
                                        DisplayMemberBinding="{ReflectionBinding DisplayName}" />
                        </arc:SettingsRow>
                    </arc:SettingsGroup>

                    <arc:SettingsGroup Header="{loc:Loc Key=Settings.LyricPriority}"
                                       Description="{loc:Loc Key=Settings.LyricPriorityHint}">
                        <arc:SettingsGroup.HeaderActions>
                            <arc:Button Variant="Ghost" Size="Small"
                                        Content="{loc:Loc Key=Settings.ShowHelp}"
                                        Command="{Binding OutputTipsCommand}" />
                        </arc:SettingsGroup.HeaderActions>
                        <arc:ReorderableList Name="LyricTypesList"
                                             Label="{loc:Loc Key=Settings.LyricPriority}"
                                             ItemsSource="{Binding LyricsTypes}">
                            <arc:ReorderableList.ItemTemplate>
                                <DataTemplate x:DataType="models:LyricsTypeEnumModel">
                                    <arc:Checkbox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </arc:ReorderableList.ItemTemplate>
                        </arc:ReorderableList>
                    </arc:SettingsGroup>
                </StackPanel>
            </arc:SettingsSection>

            <!-- 2. Extensions: translation services and sign-in cookies -->
            <arc:SettingsSection Name="ExtensionsSection"
                                 Header="{loc:Loc Key=UI.Extensions}"
                                 Icon="{x:Static arc:ArcIcons.Key}">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space6}">
                    <arc:SettingsGroup Header="{loc:Loc Key=Settings.Group.Translate}"
                                       Description="{loc:Loc Key=Settings.Group.TranslateHint}">
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra08}">
                            <arc:Input Label="{loc:Loc Key=UI.Extra08}"
                                       Text="{Binding SettingParamViewModel.BaiduAppId, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra09}">
                            <arc:PasswordField Label="{loc:Loc Key=UI.Extra09}"
                                               Text="{Binding SettingParamViewModel.BaiduSecret, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra10}">
                            <arc:PasswordField Label="{loc:Loc Key=UI.Extra10}"
                                               Text="{Binding SettingParamViewModel.CaiYunToken, Mode=TwoWay}" />
                        </arc:SettingsRow>
                    </arc:SettingsGroup>

                    <arc:SettingsGroup Header="{loc:Loc Key=Settings.Group.Cookie}"
                                       Description="{loc:Loc Key=Settings.Group.CookieHint}">
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra11}">
                            <arc:PasswordField Label="{loc:Loc Key=UI.Extra11}"
                                               Text="{Binding SettingParamViewModel.NetEaseCookie, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra12}">
                            <arc:PasswordField Label="{loc:Loc Key=UI.Extra12}"
                                               Text="{Binding SettingParamViewModel.QqMusicCookie, Mode=TwoWay}" />
                        </arc:SettingsRow>
                    </arc:SettingsGroup>
                </StackPanel>
            </arc:SettingsSection>

            <!-- 3. Network proxy -->
            <arc:SettingsSection Name="NetworkSection"
                                 Header="{loc:Loc Key=UI.Network}"
                                 Icon="{x:Static arc:ArcIcons.Globe}">
                <arc:SettingsGroup Header="{loc:Loc Key=UI.ProxySettings}"
                                   Description="{loc:Loc Key=UI.ProxyHelp}">
                    <arc:SettingsRow Header="{loc:Loc Key=UI.Type}">
                        <arc:Select ItemsSource="{Binding SettingParamViewModel.NetworkProxyModes}"
                                    SelectedItem="{Binding SettingParamViewModel.SelectedNetworkProxyModeItem}"
                                    DisplayMemberBinding="{ReflectionBinding DisplayName}" />
                    </arc:SettingsRow>
                    <arc:SettingsRow Header="{loc:Loc Key=UI.Address}">
                        <arc:Input Label="{loc:Loc Key=UI.Address}"
                                   IsEnabled="{Binding SettingParamViewModel.IsHttpProxySelected}"
                                   Text="{Binding SettingParamViewModel.ProxyHost, Mode=TwoWay}" />
                    </arc:SettingsRow>
                    <arc:SettingsRow Header="{loc:Loc Key=UI.Port}">
                        <arc:Input Name="ProxyPortInput"
                                   Label="{loc:Loc Key=UI.Port}"
                                   IsEnabled="{Binding SettingParamViewModel.IsHttpProxySelected}"
                                   ErrorMessage="{Binding SettingParamViewModel.ProxyPortError}"
                                   Text="{Binding SettingParamViewModel.ProxyPortText, Mode=TwoWay}" />
                    </arc:SettingsRow>
                    <arc:SettingsRow Header="{loc:Loc Key=UI.Username}">
                        <arc:Input Label="{loc:Loc Key=UI.Username}"
                                   IsEnabled="{Binding SettingParamViewModel.IsHttpProxySelected}"
                                   Text="{Binding SettingParamViewModel.ProxyUsername, Mode=TwoWay}" />
                    </arc:SettingsRow>
                    <arc:SettingsRow Header="{loc:Loc Key=UI.Password}">
                        <arc:PasswordField Label="{loc:Loc Key=UI.Password}"
                                           IsEnabled="{Binding SettingParamViewModel.IsHttpProxySelected}"
                                           Text="{Binding SettingParamViewModel.ProxyPassword, Mode=TwoWay}" />
                    </arc:SettingsRow>
                    <arc:SettingsGroup.Footer>
                        <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
                            <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space2}">
                                <arc:Button Variant="Secondary"
                                            Content="{loc:Loc Key=Settings.TestProxy}"
                                            Command="{Binding TestProxyCommand}"
                                            IsEnabled="{Binding SettingParamViewModel.IsHttpProxySelected}" />
                                <arc:Button Variant="Primary"
                                            Content="{loc:Loc Key=Settings.ApplyProxy}"
                                            Command="{Binding ApplyProxyCommand}" />
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Key=UI.ProxyRestart}"
                                       TextWrapping="Wrap"
                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        </StackPanel>
                    </arc:SettingsGroup.Footer>
                </arc:SettingsGroup>
            </arc:SettingsSection>

            <!-- 4. Download and cache -->
            <arc:SettingsSection Name="DownloadSection"
                                 Header="{loc:Loc Key=UI.DownloadCache}"
                                 Icon="{x:Static arc:ArcIcons.Download}">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space6}">
                    <arc:SettingsGroup Header="{loc:Loc Key=UI.DownloadBehavior}"
                                       Description="{loc:Loc Key=UI.DownloadHelp}">
                        <arc:SettingsGroup.HeaderActions>
                            <arc:Button Variant="Ghost" Size="Small"
                                        Content="{loc:Loc Key=Settings.ShowHelp}"
                                        Command="{Binding OutputTipsCommand}" />
                        </arc:SettingsGroup.HeaderActions>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.SkipInstrumental}">
                            <arc:Switch AutomationProperties.Name="{loc:Loc Key=UI.SkipInstrumental}"
                                        IsChecked="{Binding SettingParamViewModel.IgnorePureMusicInSave, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.SeparateIsolated}">
                            <arc:Switch AutomationProperties.Name="{loc:Loc Key=UI.SeparateIsolated}"
                                        IsChecked="{Binding SettingParamViewModel.SeparateFileForIsolated, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.DownloadExtras}">
                            <arc:Switch AutomationProperties.Name="{loc:Loc Key=UI.DownloadExtras}"
                                        IsChecked="{Binding SettingParamViewModel.DownloadCoverAndSongLinkOnSave, Mode=TwoWay}" />
                        </arc:SettingsRow>
                    </arc:SettingsGroup>

                    <arc:SettingsGroup Header="{loc:Loc Key=Settings.Group.Naming}">
                        <arc:SettingsRow Header="{loc:Loc Key=UI.FileName}">
                            <arc:Input Label="{loc:Loc Key=UI.FileName}"
                                       Text="{Binding SettingParamViewModel.OutputFileNameFormat, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.ArtistSeparator}">
                            <arc:Input Label="{loc:Loc Key=UI.ArtistSeparator}"
                                       Text="{Binding SettingParamViewModel.SingerSeparator, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.ArtistLimit}" Description="{loc:Loc Key=UI.Extra13}">
                            <arc:NumberField Label="{loc:Loc Key=UI.ArtistLimit}"
                                             Minimum="-1" Maximum="100" Step="1"
                                             Value="{Binding SettingParamViewModel.SingerCountLimit, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra14}">
                            <arc:Select ItemsSource="{Binding SettingParamViewModel.FileConflictStrategies}"
                                        SelectedItem="{Binding SettingParamViewModel.SelectedFileConflictStrategyItem}"
                                        DisplayMemberBinding="{ReflectionBinding DisplayName}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra15}" Description="{loc:Loc Key=UI.Extra16}">
                            <arc:Input Label="{loc:Loc Key=UI.Extra15}"
                                       IsEnabled="{Binding SettingParamViewModel.IsConflictSuffixEnabled}"
                                       Text="{Binding SettingParamViewModel.FileConflictSuffixPattern, Mode=TwoWay}" />
                        </arc:SettingsRow>
                    </arc:SettingsGroup>

                    <arc:SettingsGroup Header="{loc:Loc Key=UI.Extra17}">
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra17}" ContentAlignment="Stretch">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space2}">
                                <arc:Input Name="SaveFolderPathTextBox"
                                           Label="{loc:Loc Key=UI.Extra17}"
                                           Text="{Binding SettingParamViewModel.SaveFolderPath, Mode=TwoWay}" />
                                <arc:Button Grid.Column="1" Variant="Secondary" Size="Small"
                                            Content="{loc:Loc Key=Settings.SelectFolder}"
                                            Command="{Binding SelectSaveFolderCommand}" />
                                <arc:Button Grid.Column="2" Name="OpenSaveFolderButton" Variant="Ghost" Size="Small"
                                            Content="{loc:Loc Key=Settings.OpenFolder}"
                                            Command="{Binding OpenSaveFolderCommand}" />
                            </Grid>
                        </arc:SettingsRow>
                    </arc:SettingsGroup>

                    <arc:SettingsGroup Header="{loc:Loc Key=UI.Extra19}">
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra20}" ContentAlignment="Stretch">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space2}">
                                <arc:Input Label="{loc:Loc Key=UI.Extra20}"
                                           Text="{Binding SettingParamViewModel.SearchCacheFolderPath, Mode=TwoWay}" />
                                <arc:Button Grid.Column="1" Variant="Secondary" Size="Small"
                                            Content="{loc:Loc Key=Settings.SelectFolder}"
                                            Command="{Binding SelectSearchCacheFolderCommand}" />
                                <arc:Button Grid.Column="2" Variant="Ghost" Size="Small"
                                            Content="{loc:Loc Key=Settings.OpenFolder}"
                                            Command="{Binding OpenSearchCachePathCommand}" />
                            </Grid>
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra23}">
                            <arc:Input Name="CacheSizeInput"
                                       Label="{loc:Loc Key=UI.Extra23}"
                                       ErrorMessage="{Binding SettingParamViewModel.SearchCacheSizeError}"
                                       Text="{Binding SettingParamViewModel.SearchCacheMaxSizeMbText, Mode=TwoWay}" />
                        </arc:SettingsRow>
                    </arc:SettingsGroup>
                </StackPanel>
            </arc:SettingsSection>

            <!-- 5. Application -->
            <arc:SettingsSection Name="ApplicationSection"
                                 Header="{loc:Loc Key=UI.Application}"
                                 Icon="{x:Static arc:ArcIcons.Settings}">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space6}">
                    <arc:SettingsGroup Header="{loc:Loc Key=Settings.Group.Appearance}">
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra28}">
                            <arc:Select ItemsSource="{Binding SettingParamViewModel.ThemeModeRules}"
                                        SelectedItem="{Binding SettingParamViewModel.SelectedThemeModeRuleItem}"
                                        DisplayMemberBinding="{ReflectionBinding DisplayName}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Language}" Description="{loc:Loc Key=UI.LanguageRestart}">
                            <arc:Select ItemsSource="{Binding SettingParamViewModel.Languages}"
                                        SelectedItem="{Binding SettingParamViewModel.SelectedLanguage}"
                                        DisplayMemberBinding="{ReflectionBinding DisplayName}" />
                        </arc:SettingsRow>
                    </arc:SettingsGroup>

                    <arc:SettingsGroup Header="{loc:Loc Key=Settings.Group.Behavior}">
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra24}">
                            <arc:Switch AutomationProperties.Name="{loc:Loc Key=UI.Extra24}"
                                        IsChecked="{Binding SettingParamViewModel.AggregatedBlurSearch, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra25}">
                            <arc:Switch AutomationProperties.Name="{loc:Loc Key=UI.Extra25}"
                                        IsChecked="{Binding SettingParamViewModel.AutoReadClipboard, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra27}">
                            <arc:Switch AutomationProperties.Name="{loc:Loc Key=UI.Extra27}"
                                        IsChecked="{Binding SettingParamViewModel.ConfirmBeforeExit, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.EnableFileLogging}">
                            <arc:Switch AutomationProperties.Name="{loc:Loc Key=UI.EnableFileLogging}"
                                        IsChecked="{Binding SettingParamViewModel.EnableFileLogging, Mode=TwoWay}" />
                        </arc:SettingsRow>
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra26}">
                            <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space3}">
                                <arc:Button Variant="Secondary" Size="Small"
                                            Content="{loc:Loc Key=UI.Extra29}"
                                            Command="{Binding CheckUpdateCommand}" />
                                <arc:Switch AutomationProperties.Name="{loc:Loc Key=UI.Extra26}"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding SettingParamViewModel.AutoCheckUpdate, Mode=TwoWay}" />
                            </StackPanel>
                        </arc:SettingsRow>
                    </arc:SettingsGroup>

                    <arc:SettingsGroup Header="{loc:Loc Key=UI.Extra30}">
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra31}" />
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra32}" />
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra33}" />
                    </arc:SettingsGroup>

                    <arc:SettingsGroup Header="{loc:Loc Key=UI.Extra34}">
                        <arc:SettingsRow Header="{loc:Loc Key=UI.Extra34}" ContentAlignment="Stretch">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{arc:ArcDesignTokenResource Space2}">
                                <arc:Input Label="{loc:Loc Key=UI.Extra34}" Text="{Binding ConfigPath}" IsReadOnly="True" />
                                <arc:Button Grid.Column="1" Variant="Ghost" Size="Small"
                                            Content="{loc:Loc Key=Settings.OpenConfig}"
                                            Command="{Binding OpenConfigPathCommand}" />
                            </Grid>
                        </arc:SettingsRow>
                    </arc:SettingsGroup>
                </StackPanel>
            </arc:SettingsSection>
        </arc:SettingsPage>
    </Grid>
</UserControl>
