<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:MusicLyricApp.ViewModels"
             xmlns:loc="using:MusicLyricApp.Core.Localization"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="640"
             x:Class="MusicLyricApp.Views.FormatConvertView"
             x:DataType="vm:FormatConvertViewModel">

    <UserControl.Styles>
        <Style Selector="Border.pane">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusSurface}" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="24,16,24,24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{arc:ArcDesignTokenResource Space4}">

        <StackPanel Spacing="{arc:ArcDesignTokenResource Space1}">
            <TextBlock Text="{loc:Loc Key=Nav.Convert}"
                       FontSize="{arc:ArcDesignTokenResource TypeXL}"
                       FontWeight="SemiBold"
                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
            <TextBlock Text="{loc:Loc Key=Convert.Description}"
                       TextWrapping="Wrap"
                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        </StackPanel>

        <!-- Formats: from → to, with a swap that also swaps the texts. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space3}">
            <arc:Select Name="SourceFormatSelect"
                        MinWidth="140"
                        Size="Small"
                        Label="{loc:Loc Key=UI.InputFormat}"
                        ItemsSource="{Binding Formats}"
                        SelectedItem="{Binding SourceFormatItem}"
                        DisplayMemberBinding="{ReflectionBinding DisplayName}" />
            <arc:Button Name="SwapButton"
                        Variant="Ghost"
                        Size="Small"
                        VerticalAlignment="Bottom"
                        Command="{Binding SwapFormatCommand}"
                        ToolTip.Tip="{loc:Loc Key=Convert.Swap}"
                        AutomationProperties.Name="{loc:Loc Key=Convert.Swap}">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ArrowRight}" />
            </arc:Button>
            <arc:Select Name="TargetFormatSelect"
                        MinWidth="140"
                        Size="Small"
                        Label="{loc:Loc Key=UI.OutputFormat2}"
                        ItemsSource="{Binding Formats}"
                        SelectedItem="{Binding TargetFormatItem}"
                        DisplayMemberBinding="{ReflectionBinding DisplayName}" />
        </StackPanel>

        <arc:ResizablePanels Grid.Row="2" Gap="{arc:ArcDesignTokenResource Space4}" Label="{loc:Loc Key=Nav.Convert}">
            <arc:ResizablePanel Id="input" Label="{loc:Loc Key=Convert.Input}" MinSize="260">
                <arc:Textarea Name="InputTextArea"
                              Label="{loc:Loc Key=Convert.Input}"
                              Placeholder="{loc:Loc Key=Convert.InputPlaceholder}"
                              AcceptsReturn="True"
                              TextWrapping="Wrap"
                              IsResizable="False"
                              FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                              Text="{Binding InputText, Mode=TwoWay}" />
            </arc:ResizablePanel>
            <arc:ResizablePanel Id="output" Label="{loc:Loc Key=Convert.Output}" MinSize="260">
                <Border Classes="pane">
                    <Panel>
                        <arc:EmptyState Name="OutputEmptyState"
                                        IsVisible="{Binding !HasOutput}"
                                        Icon="{x:Static arc:ArcIcons.FileText}"
                                        Title="{loc:Loc Key=Convert.Output}"
                                        Description="{loc:Loc Key=Convert.OutputEmpty}" />
                        <ScrollViewer IsVisible="{Binding HasOutput}">
                            <arc:CodeBlock Name="OutputBlock"
                                           Code="{Binding OutputText}"
                                           Language="lrc"
                                           FileName="{loc:Loc Key=Convert.Output}"
                                           ShowLineNumbers="True"
                                           CopyLabel="{loc:Loc Key=Convert.CopyOutput}" />
                        </ScrollViewer>
                    </Panel>
                </Border>
            </arc:ResizablePanel>
        </arc:ResizablePanels>

        <!-- Conversion status; failures stay visible as an alert until the input changes. -->
        <Panel Grid.Row="3">
            <TextBlock Name="TipText"
                       IsVisible="{Binding !IsTipError}"
                       Text="{Binding TipMessage}"
                       TextTrimming="CharacterEllipsis"
                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            <arc:Alert Name="TipAlert"
                       Tone="Danger"
                       Title="{Binding TipMessage}"
                       IsVisible="{Binding IsTipError}" />
        </Panel>
    </Grid>
</UserControl>
