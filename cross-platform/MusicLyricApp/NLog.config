<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off">

  <!-- logDir is set at startup by LoggingService from Constants.GetLogFolderPath(); file output stays off without it. -->

  <targets async="true">
    <target name="file" xsi:type="AsyncWrapper" queueLimit="5000" overflowAction="Discard">
      <target xsi:type="File"
              fileName="${var:logDir}/MusicLyricApp-${shortdate}.log"
              encoding="utf-8"
              layout="${longdate} | ${level:uppercase=true:padding=-5} | ${message:exceptionSeparator=\r\n:withException=true}" />
    </target>

    <target name="debugger" encoding="utf-8"
            useDefaultRowHighlightingRules="True"
            enableAnsiOutput="False"
            xsi:type="Debugger"
            layout="${date:format=HH\:mm\:ss} ${callsite:includeNamespace=False} | ${level:uppercase=true:padding=-5} | ${message:exceptionSeparator=\r\n:withException=true}" />
  </targets>

  <rules>
    <logger name="*" minlevel="INFO" writeTo="file">
      <filters defaultAction="Neutral">
        <when condition="'${var:fileLoggingEnabled}' == 'false'" action="Ignore" />
        <when condition="'${var:logDir}' == ''" action="Ignore" />
      </filters>
    </logger>
    <logger name="*" minlevel="TRACE" writeTo="debugger" />
  </rules>
</nlog>
